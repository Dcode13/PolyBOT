# Hanya diperlukan untuk live, jangan pernah bagikan file .env atau private key.
# Alamat wallet Polymarket yang sudah dibuat; bukan sekadar alamat signer.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=

# Buat melalui @BotFather. Token hanya disimpan lokal, jangan dikirim ke chat.
TELEGRAM_BOT_TOKEN=
# Isi otomatis lewat: python -m polybot.telegram --pair
TELEGRAM_ALLOWED_USER_ID=
